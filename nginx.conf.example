# Пример конфигурации Nginx для VPS деплоя
# Сохраните этот файл как /etc/nginx/sites-available/compliance-backend

server {
    listen 80;
    server_name 31.97.79.59 srv1066622.hstgr.cloud;
    # Если у вас есть домен, добавьте его:
    # server_name ваш-домен.com www.ваш-домен.com;

    # Логи
    access_log /var/log/nginx/compliance-backend-access.log;
    error_log /var/log/nginx/compliance-backend-error.log;

    # Увеличение размера загружаемых файлов (для импорта Excel)
    client_max_body_size 50M;

    # Проксирование на backend
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Таймауты для больших файлов (импорт Excel)
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        
        # WebSocket поддержка (если понадобится)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Статические файлы (если нужно)
    location /static/ {
        alias /opt/compliance-monitor/backend/static/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}

# Если настроили SSL, добавьте этот блок:
# server {
#     listen 443 ssl http2;
#     server_name ваш-домен.com www.ваш-домен.com;
#
#     ssl_certificate /etc/letsencrypt/live/ваш-домен.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/ваш-домен.com/privkey.pem;
#
#     # Остальная конфигурация аналогична блоку выше
#     # ...
# }
